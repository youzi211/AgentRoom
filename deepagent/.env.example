# Secrets template. Copy this file to .env and never commit the filled .env.

# Required for live web research.
TAVILY_API_KEY=

# Recommended model configuration.
# For an OpenAI-compatible custom endpoint:
# MODEL_PROTOCOL=openai
# MODEL_BASE_URL=https://your-proxy.com/v1
# MODEL_NAME=your-model
# MODEL_API_KEY=sk-...

# For a provider-native model, leave MODEL_BASE_URL empty and use a provider
# prefixed model name such as openai:gpt-5.5 or anthropic:claude-sonnet-4-6.
#
# Credential reference mapping (ADR-001 unified model execution boundary):
#   environment:go        -> LLM_BASE_URL + LLM_API_KEY + LLM_MODEL
#   environment:deepagent -> MODEL_BASE_URL + MODEL_API_KEY + MODEL_NAME
#   profile:<id>          -> requires a production CredentialResolver adapter;
#                            fails at preparation stage without env fallback.
MODEL_PROTOCOL=openai
MODEL_BASE_URL=
MODEL_NAME=openai:gpt-5.5
MODEL_API_KEY=

# Provider-native key aliases still work if you prefer them.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Legacy aliases still work, but MODEL_* is preferred.
# DEEPAGENT_MODEL=openai:gpt-5.5
# CUSTOM_ENABLED=true
# CUSTOM_PROTOCOL=openai
# CUSTOM_BASE_URL=https://your-proxy.com/v1
# CUSTOM_API_KEY=sk-...
# CUSTOM_MODEL_NAME=your-model

# Optional runtime overrides.
# RESEARCH_MAX_RESULTS=5
# RESEARCH_TOPIC=general
# RESEARCH_INCLUDE_RAW_CONTENT=false
# RESEARCH_OUTPUT_DIR=runs
# RESEARCH_STREAM_UPDATES=true

# Agent Runtime server settings.
AGENT_RUNTIME_HOST=127.0.0.1
AGENT_RUNTIME_PORT=50051
AGENT_RUNTIME_INSECURE=true
AGENT_RUNTIME_MAX_CONCURRENCY=4
AGENT_RUNTIME_DEEPAGENT_CONCURRENCY=1
AGENT_RUNTIME_MAX_PENDING=16
AGENT_RUNTIME_MAX_REQUEST_BYTES=8388608
AGENT_RUNTIME_MAX_EVENT_BYTES=4194304
AGENT_RUNTIME_MAX_ARTIFACT_BYTES=2097152
AGENT_RUNTIME_MAX_OUTPUT_BYTES=1048576
AGENT_RUNTIME_EVENT_BUFFER_SIZE=16
AGENT_RUNTIME_SHUTDOWN_GRACE_SECONDS=10
AGENT_RUNTIME_WORK_DIR=runs/runtime

# Collaboration Runtime and Engine Registry controls.
COLLABORATION_RUNTIME_ENABLED=true
COLLABORATION_ENGINE_ALLOWLIST=native
COLLABORATION_AUTOGEN_ENABLED=false
COLLABORATION_MAX_CONCURRENCY=4
COLLABORATION_MAX_PENDING=16
COLLABORATION_CHECKPOINT_MAX_BYTES=1048576
COLLABORATION_DEFAULT_ENGINE=native
COLLABORATION_DEFAULT_TRIGGER_MODE=mention_only
