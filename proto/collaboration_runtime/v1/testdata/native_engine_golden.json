{
  "cases": [
    {
      "name": "normalized_handoff_and_audit",
      "trigger": "@Author start the review.",
      "agents": [
        {"id": "author", "name": "Author"},
        {"id": "reviewer", "name": "Reviewer"},
        {"id": "architect", "name": "Architect"}
      ],
      "initial_candidate_agent_ids": ["author"],
      "policy": {"max_turns": 3, "max_turns_per_agent": 1},
      "responses": [
        {
          "agent_id": "author",
          "content": "Please ask ＠Reviewer and @ Architect to review.",
          "activity_text": "internal progress must not become a message",
          "artifact_id": "report-author",
          "knowledge_document_id": "doc-plan",
          "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
        },
        {
          "agent_id": "reviewer",
          "content": "Reviewer follow-up.",
          "artifact_id": "report-reviewer",
          "knowledge_document_id": "doc-review",
          "model": {"profile_id": "profile-reviewer", "source": "database", "model_name": "research-model"}
        },
        {
          "agent_id": "architect",
          "content": "Architect follow-up.",
          "artifact_id": "report-architect",
          "knowledge_document_id": "doc-architecture",
          "model": {"profile_id": "profile-architect", "source": "database", "model_name": "research-model"}
        }
      ],
      "expected": {
        "speaker_ids": ["author", "reviewer", "architect"],
        "messages": [
          {
            "agent_id": "author",
            "content": "Please ask ＠Reviewer and @ Architect to review.",
            "artifact_id": "report-author",
            "knowledge_document_id": "doc-plan",
            "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
          },
          {
            "agent_id": "reviewer",
            "content": "Reviewer follow-up.",
            "artifact_id": "report-reviewer",
            "knowledge_document_id": "doc-review",
            "model": {"profile_id": "profile-reviewer", "source": "database", "model_name": "research-model"}
          },
          {
            "agent_id": "architect",
            "content": "Architect follow-up.",
            "artifact_id": "report-architect",
            "knowledge_document_id": "doc-architecture",
            "model": {"profile_id": "profile-architect", "source": "database", "model_name": "research-model"}
          }
        ],
        "terminal": {"kind": "completed", "reason": "completed", "turn_count": 3}
      }
    },
    {
      "name": "duplicate_output_is_not_committed",
      "trigger": "@Author start the review.",
      "agents": [
        {"id": "author", "name": "Author"},
        {"id": "reviewer", "name": "Reviewer"}
      ],
      "initial_candidate_agent_ids": ["author"],
      "policy": {"max_turns": 4, "max_turns_per_agent": 2},
      "responses": [
        {
          "agent_id": "author",
          "content": "@Reviewer Shared duplicate content.",
          "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
        },
        {
          "agent_id": "reviewer",
          "content": "Shared duplicate content.",
          "model": {"profile_id": "profile-reviewer", "source": "database", "model_name": "research-model"}
        }
      ],
      "expected": {
        "speaker_ids": ["author", "reviewer"],
        "messages": [
          {
            "agent_id": "author",
            "content": "@Reviewer Shared duplicate content.",
            "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
          }
        ],
        "terminal": {"kind": "stopped", "reason": "duplicate_output", "turn_count": 1}
      }
    },
    {
      "name": "empty_output_is_not_committed",
      "trigger": "@Author start the review.",
      "agents": [{"id": "author", "name": "Author"}],
      "initial_candidate_agent_ids": ["author"],
      "policy": {"max_turns": 2, "max_turns_per_agent": 1},
      "responses": [
        {
          "agent_id": "author",
          "content": "  \n\t",
          "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
        }
      ],
      "expected": {
        "speaker_ids": ["author"],
        "messages": [],
        "terminal": {"kind": "stopped", "reason": "empty_output", "turn_count": 0}
      }
    },
    {
      "name": "total_turn_limit",
      "trigger": "@Author start the review.",
      "agents": [
        {"id": "author", "name": "Author"},
        {"id": "reviewer", "name": "Reviewer"}
      ],
      "initial_candidate_agent_ids": ["author"],
      "policy": {"max_turns": 2, "max_turns_per_agent": 2},
      "responses": [
        {
          "agent_id": "author",
          "content": "@Reviewer First pass.",
          "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
        },
        {
          "agent_id": "reviewer",
          "content": "@Author Second pass.",
          "model": {"profile_id": "profile-reviewer", "source": "database", "model_name": "research-model"}
        }
      ],
      "expected": {
        "speaker_ids": ["author", "reviewer"],
        "messages": [
          {
            "agent_id": "author",
            "content": "@Reviewer First pass.",
            "model": {"profile_id": "profile-author", "source": "database", "model_name": "research-model"}
          },
          {
            "agent_id": "reviewer",
            "content": "@Author Second pass.",
            "model": {"profile_id": "profile-reviewer", "source": "database", "model_name": "research-model"}
          }
        ],
        "terminal": {"kind": "stopped", "reason": "max_turns", "turn_count": 2}
      }
    }
  ]
}
